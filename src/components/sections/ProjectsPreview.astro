---
import { projects, getProjectHref } from '../../data/projects';
import Button from '../ui/Button.astro';

const featured = projects.slice(0, 6);
---

<section class="projects section" aria-labelledby="projects-title">
  <div class="container">
    <header class="projects__header">
      <h2 id="projects-title" class="projects__title">Proyectos en Madrid</h2>
      <p class="projects__intro">
        Algunos de nuestros trabajos de rehabilitación energética, SATE y reformas integrales en la
        Comunidad de Madrid.
      </p>
    </header>

    <div class="projects__grid">
      {
        featured.map((project) => (
          <a href={getProjectHref(project.slug)} class="projects__card">
            <div class="projects__media">
              <img src={project.image.src} alt={project.image.alt} loading="lazy" decoding="async" />
            </div>
            <div class="projects__body">
              <span class="projects__tag">{project.service}</span>
              <h3>{project.title}</h3>
              <p>{project.location}</p>
            </div>
          </a>
        ))
      }
    </div>

    <div class="projects__cta">
      <Button href="/proyectos" variant="primary">Ver todos los proyectos</Button>
    </div>
  </div>
</section>

<style>
  .projects {
    background: #f8fafc;
  }

  .projects__header {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 2rem;
  }

  .projects__title {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 700;
    text-transform: uppercase;
  }

  .projects__intro {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .projects__grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }

  .projects__card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .projects__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(13, 20, 26, 0.08);
  }

  .projects__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-border);
  }

  .projects__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .projects__body {
    padding: 1.25rem;
  }

  .projects__tag {
    display: inline-block;
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
  }

  .projects__body h3 {
    margin: 0 0 0.375rem;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .projects__body p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .projects__cta {
    margin-top: 2.5rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .projects__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
