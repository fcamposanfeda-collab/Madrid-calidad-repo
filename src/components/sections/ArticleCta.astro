---
import Button from '../ui/Button.astro';
import { getServiceHref } from '../../data/services-seo';

interface Props {
  serviceSlug?: string;
}

const { serviceSlug } = Astro.props;
const href = serviceSlug ? getServiceHref(serviceSlug) : null;
---

<aside class="article-cta section" aria-label="Solicitar presupuesto">
  <div class="container article-cta__inner">
    <h2>¿Necesitas presupuesto para tu proyecto en Madrid?</h2>
    <p>Solicita una valoración sin compromiso. Te asesoramos y gestionamos ayudas si procede.</p>
    <div class="article-cta__actions">
      <Button href="/presupuestos" variant="primary">Solicitar presupuesto</Button>
      {href && <Button href={href} variant="outline">Ver servicio relacionado</Button>}
      {!href && <Button href="/contacto" variant="outline">Contactar</Button>}
    </div>
  </div>
</aside>

<style>
  .article-cta {
    background: var(--color-secondary);
    color: var(--color-on-primary);
    padding-block: 2.5rem;
  }

  .article-cta__inner {
    text-align: center;
    max-width: 36rem;
    margin-inline: auto;
  }

  .article-cta h2 {
    margin: 0 0 0.5rem;
    font-family: var(--font-heading);
    font-size: 1.375rem;
    text-transform: uppercase;
    color: var(--color-on-primary);
  }

  .article-cta p {
    margin: 0 0 1.25rem;
    opacity: 0.92;
    line-height: 1.6;
  }

  .article-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .article-cta__actions :global(.btn--outline) {
    border-color: rgba(255, 255, 255, 0.6);
    color: var(--color-on-primary);
  }

  .article-cta__actions :global(.btn--outline:hover) {
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-on-primary);
  }
</style>
