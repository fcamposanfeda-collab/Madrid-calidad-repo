---
import Button from '../ui/Button.astro';
import { images } from '../../data/images';

const { hero } = images;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__background">
    <img
      src={hero.src}
      alt=""
      role="presentation"
      class="hero__image"
      width="1280"
      height="720"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero__overlay" aria-hidden="true"></div>
  </div>

  <div class="hero__content container">
    <h1 id="hero-title" class="hero__title">MADRID CALIDAD CONSTRUCTIVA</h1>
    <p class="hero__subtitle">EFICIENCIA - CONFORT - SOSTENIBILIDAD</p>
    <Button href="/contacto" variant="primary">Contáctanos</Button>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(28rem, 70vh, 42rem);
    color: var(--color-on-primary);
    overflow: hidden;
  }

  .hero__background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(26, 42, 56, 0.82) 0%,
      rgba(41, 90, 130, 0.65) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: 3rem;
    max-width: 42rem;
  }

  .hero__title {
    margin: 0 0 1rem;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-on-primary);
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.4);
  }

  .hero__subtitle {
    margin: 0 0 2rem;
    font-family: var(--font-heading);
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-on-primary);
    opacity: 0.95;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
  }

  @media (min-width: 768px) {
    .hero__content {
      padding-block: 4rem;
    }
  }
</style>
