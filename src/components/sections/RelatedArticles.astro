---
import ArticleCard from './ArticleCard.astro';
import Button from '../ui/Button.astro';
import type { Articulo } from '../../utils/articles';

interface Props {
  articles: Articulo[];
  title?: string;
  showAllLink?: boolean;
}

const { articles, title = 'Artículos relacionados', showAllLink = true } = Astro.props;
---

<section class="related-articles section" aria-labelledby="related-articles-title">
  <div class="container">
    <div class="related-articles__header">
      <h2 id="related-articles-title" class="related-articles__title">{title}</h2>
      {showAllLink && <Button href="/articulos" variant="outline">Ver todos</Button>}
    </div>
    <div class="related-articles__grid">
      {articles.map((article) => <ArticleCard article={article} />)}
    </div>
  </div>
</section>

<style>
  .related-articles {
    background: #f8fafc;
    border-top: 1px solid var(--color-border);
  }

  .related-articles__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .related-articles__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.375rem;
    text-transform: uppercase;
  }

  .related-articles__grid {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .related-articles__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
