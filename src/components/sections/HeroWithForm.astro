---
import QuoteForm from '../forms/QuoteForm.astro';
import { stockImages } from '../../data/placeholders';

const heroImage = stockImages.piso;
---

<section class="hero-reiteman" aria-labelledby="hero-title">
  <div class="hero-reiteman__bg">
    <img
      src={heroImage.src}
      alt=""
      role="presentation"
      width="1920"
      height="1080"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-reiteman__overlay" aria-hidden="true"></div>
  </div>

  <div class="container hero-reiteman__grid">
    <div class="hero-reiteman__copy">
      <h1 id="hero-title" class="hero-reiteman__title">Rehabilitación y reformas integrales en Madrid</h1>
      <hr class="hero-reiteman__rule" />
      <p class="hero-reiteman__lead">
        En Madrid Calidad Constructiva somos especialistas en rehabilitación energética y reformas
        integrales en Madrid, con gestión de subvenciones y un equipo técnico que te acompaña desde el
        estudio hasta la entrega de obra en viviendas, comunidades y locales.
      </p>
    </div>

    <aside class="hero-reiteman__aside" aria-label="Solicitar presupuesto">
      <div class="hero-reiteman__card">
        <h2 class="hero-reiteman__form-title">Pide presupuesto ahora</h2>
        <QuoteForm formId="hero-quote" variant="hero" submitLabel="Solicite presupuesto" />
      </div>
    </aside>
  </div>
</section>

<style>
  .hero-reiteman {
    position: relative;
    min-height: clamp(32rem, 85vh, 44rem);
    display: flex;
    align-items: center;
    color: var(--color-on-primary);
    overflow: hidden;
  }

  .hero-reiteman__bg {
    position: absolute;
    inset: 0;
  }

  .hero-reiteman__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-reiteman__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(13, 20, 26, 0.82) 0%,
      rgba(26, 42, 56, 0.75) 100%
    );
  }

  .hero-reiteman__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2.5rem;
    align-items: center;
    width: 100%;
    padding-block: 3rem 3.5rem;
  }

  .hero-reiteman__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-transform: none;
    max-width: 14ch;
    color: var(--color-on-primary);
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.4);
  }

  .hero-reiteman__rule {
    width: 4.5rem;
    height: 3px;
    margin: 1.25rem 0 1.5rem;
    border: none;
    background: rgba(255, 255, 255, 0.85);
  }

  .hero-reiteman__lead {
    margin: 0;
    max-width: 36rem;
    font-size: clamp(1rem, 1.8vw, 1.1875rem);
    line-height: 1.65;
    font-weight: 400;
    color: var(--color-on-primary);
    opacity: 0.95;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
  }

  .hero-reiteman__card {
    background: var(--color-bg);
    color: var(--color-text);
    padding: 1.75rem 1.75rem 1.5rem;
    border-radius: 0.25rem;
    box-shadow: 0 20px 50px rgba(13, 20, 26, 0.22);
  }

  .hero-reiteman__form-title {
    margin: 0 0 1.25rem;
    font-family: var(--font-primary);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-secondary);
    line-height: 1.3;
  }

  @media (min-width: 992px) {
    .hero-reiteman__grid {
      grid-template-columns: 1fr min(26.5rem, 38%);
      gap: 3rem 4rem;
      padding-block: 4rem 4.5rem;
    }

    .hero-reiteman__aside {
      justify-self: end;
      width: 100%;
      max-width: 26.5rem;
    }
  }
</style>
