---
import type { LegalDocument } from '../../types/legal';

interface Props {
  document: LegalDocument;
}

const { document } = Astro.props;
---

<article class="legal-content">
  <header class="legal-content__header">
    <h1 class="legal-content__title">{document.title}</h1>
    {
      document.intro?.map((paragraph) => (
        <p class="legal-content__intro">{paragraph}</p>
      ))
    }
  </header>

  {
    document.sections.map((section) => (
      <section class="legal-content__section">
        <h2 class="legal-content__section-title">{section.title}</h2>
        {
          section.paragraphs?.map((paragraph) => (
            <p class="legal-content__paragraph">{paragraph}</p>
          ))
        }
        {
          section.list && (
            <ul class="legal-content__list">
              {section.list.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )
        }
        {
          section.subsections?.map((subsection) => (
            <div class="legal-content__subsection">
              {subsection.title && (
                <h3 class="legal-content__subsection-title">{subsection.title}</h3>
              )}
              {
                subsection.paragraphs?.map((paragraph) => (
                  <p class="legal-content__paragraph">{paragraph}</p>
                ))
              }
              {
                subsection.list && (
                  <ul class="legal-content__list">
                    {subsection.list.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )
              }
            </div>
          ))
        }
      </section>
    ))
  }
</article>

<style>
  .legal-content {
    max-width: 45rem;
    margin-inline: auto;
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .legal-content__header {
    margin-bottom: 2.5rem;
  }

  .legal-content__title {
    margin: 0 0 1.5rem;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .legal-content__intro {
    margin: 0 0 0.5rem;
    color: var(--color-muted);
  }

  .legal-content__section {
    margin-bottom: 2rem;
  }

  .legal-content__section-title {
    margin: 0 0 1rem;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .legal-content__subsection {
    margin-top: 1.25rem;
  }

  .legal-content__subsection-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .legal-content__paragraph {
    margin: 0 0 1rem;
  }

  .legal-content__list {
    margin: 0 0 1rem;
    padding-left: 1.5rem;
  }

  .legal-content__list li {
    margin-bottom: 0.5rem;
  }
</style>
