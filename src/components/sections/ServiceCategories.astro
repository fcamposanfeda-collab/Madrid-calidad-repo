---
import { getServiceHref } from '../../data/services-seo';
import { stockImages } from '../../data/placeholders';
import Button from '../ui/Button.astro';

const categories = [
  {
    title: 'Rehabilitación',
    image: {
      src: 'https://upload.wikimedia.org/wikipedia/commons/thumb/e/ef/Calle_de_Sagasta_n%C2%BA_31-33_%28Madrid%29_02.jpg/1280px-Calle_de_Sagasta_n%C2%BA_31-33_%28Madrid%29_02.jpg',
      alt: 'Edificios de viviendas en la calle de Sagasta, Madrid',
    },
    credit: {
      author: 'Luis García',
      source: 'https://commons.wikimedia.org/wiki/File:Calle_de_Sagasta_n%C2%BA_31-33_(Madrid)_02.jpg',
      licenseHref: 'https://creativecommons.org/licenses/by-sa/3.0/es/deed.es',
    },
    links: [
      { label: 'Trabajos verticales', slug: 'trabajos-verticales-madrid' },
      { label: 'Fachadas', slug: 'rehabilitacion-fachadas-madrid' },
      { label: 'Cubiertas', slug: 'rehabilitacion-cubiertas-madrid' },
      { label: 'Impermeabilización', slug: 'impermeabilizacion-madrid' },
      { label: 'Rehabilitación energética', slug: 'rehabilitacion-energetica-madrid' },
      { label: 'SATE Madrid', slug: 'sate-madrid' },
    ],
  },
  {
    title: 'Reformas',
    image: stockImages.piso,
    links: [
      { label: 'Reforma integral', slug: 'reforma-integral-madrid' },
      { label: 'Reforma de cocina', slug: 'reforma-cocina-madrid' },
      { label: 'Reforma de baño', slug: 'reforma-bano-madrid' },
      { label: 'Reforma de piso', slug: 'reforma-piso-madrid' },
      { label: 'Reforma de chalets', slug: 'reforma-chalets-madrid' },
      { label: 'Reforma de locales', slug: 'reforma-locales-madrid' },
    ],
  },
  {
    title: 'Servicios profesionales',
    image: {
      src: 'https://images.unsplash.com/photo-1646227655685-a530813759b3?w=1200&h=525&fit=crop&crop=faces&q=80',
      alt: 'Operario con casco',
    },
    links: [
      { label: 'Electricidad', slug: 'electricidad-madrid' },
      { label: 'Fontanería', slug: 'fontaneria-madrid' },
      { label: 'Albañilería', slug: 'albanileria-madrid' },
      { label: 'Pintura', slug: 'pintura-madrid' },
      { label: 'Carpintería', slug: 'carpinteria-madrid' },
      { label: 'Certificados energéticos', slug: 'certificados-energeticos-madrid' },
    ],
  },
];
---

<section class="categories section" aria-labelledby="categories-title">
  <div class="container">
    <h2 id="categories-title" class="categories__title">Trabajos verticales y rehabilitación en Madrid</h2>
    <p class="categories__intro">
      Los trabajos verticales son nuestra especialidad: fachadas, cubiertas e impermeabilización en
      altura. También rehabilitamos y reformamos para comunidades, particulares y locales en toda la
      Comunidad de Madrid.
    </p>

    <div class="categories__grid">
      {
        categories.map((cat) => (
          <article class="categories__card">
            <div class="categories__media">
              <img src={cat.image.src} alt={cat.image.alt} loading="lazy" decoding="async" />
              {'credit' in cat && cat.credit && (
                <p class="categories__credit">
                  Foto:{' '}
                  <a href={cat.credit.source}>{cat.credit.author}</a>
                  {' · '}
                  <a href={cat.credit.licenseHref}>CC BY-SA 3.0</a>
                </p>
              )}
              <h3>{cat.title}</h3>
            </div>
            <ul>
              {cat.links.map((link) => (
                <li>
                  <a href={getServiceHref(link.slug)}>{link.label}</a>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="categories__cta">
      <Button href="/servicios" variant="primary">Ver todos los servicios</Button>
    </div>
  </div>
</section>

<style>
  .categories__title {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 700;
    text-transform: uppercase;
    text-align: center;
  }

  .categories__intro {
    margin: 0 auto 2.5rem;
    max-width: 42rem;
    text-align: center;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .categories__grid {
    display: grid;
    gap: 1.5rem;
  }

  .categories__card {
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--color-bg);
  }

  .categories__media {
    position: relative;
    aspect-ratio: 16 / 7;
    overflow: hidden;
  }

  .categories__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .categories__credit {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
    z-index: 1;
    margin: 0;
    padding: 0.15rem 0.45rem;
    font-size: 0.65rem;
    line-height: 1.3;
    color: #fff;
    background: rgba(26, 42, 56, 0.92);
    border-radius: 0.2rem;
  }

  .categories__credit a {
    color: inherit;
  }

  .categories__media h3 {
    position: absolute;
    inset: auto 0 0 0;
    margin: 0;
    padding: 1rem 1.25rem;
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-on-primary);
    background: linear-gradient(transparent, rgba(26, 42, 56, 0.9));
  }

  .categories__card ul {
    margin: 0;
    padding: 1rem 1.25rem 1.25rem;
    display: grid;
    gap: 0.375rem;
  }

  .categories__card a {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-primary);
  }

  .categories__card a:hover {
    text-decoration: underline;
  }

  .categories__cta {
    margin-top: 2.5rem;
    text-align: center;
  }

  @media (min-width: 992px) {
    .categories__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
