---
import { servicePills } from '../../data/service-pills';
---

<section class="service-pills section" aria-label="Áreas de servicio">
  <div class="container">
    <ul class="service-pills__list">
      {
        servicePills.map((pill) => (
          <li class="service-pills__item">
            <h3 class="service-pills__title">{pill.title}</h3>
            {pill.bullets.length > 0 && (
              <ul class="service-pills__bullets">
                {pill.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .service-pills {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .service-pills__list {
    display: grid;
    gap: 2rem;
  }

  .service-pills__item {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-bg);
  }

  .service-pills__title {
    margin: 0 0 1rem;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-primary);
  }

  .service-pills__bullets {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .service-pills__bullets li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  .service-pills__bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-primary);
  }

  @media (min-width: 768px) {
    .service-pills__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }
</style>
