---
import Button from '../ui/Button.astro';
import { homeProcessIntro, homeProcessSteps } from '../../data/home-process';
---

<section class="process-overview section" aria-labelledby="process-overview-title">
  <div class="container">
    <header class="process-overview__header">
      <h2 id="process-overview-title" class="process-overview__title">{homeProcessIntro.title}</h2>
      <p class="process-overview__subtitle">{homeProcessIntro.subtitle}</p>
    </header>

    <ol class="process-overview__steps">
      {
        homeProcessSteps.map((item) => (
          <li class="process-overview__step">
            <span class="process-overview__number" aria-hidden="true">
              {item.step}
            </span>
            <div class="process-overview__content">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="process-overview__cta">
      <Button href={homeProcessIntro.ctaHref} variant="outline">
        {homeProcessIntro.ctaLabel}
      </Button>
    </div>
  </div>
</section>

<style>
  .process-overview {
    background: #f8fafc;
    border-block: 1px solid var(--color-border);
  }

  .process-overview__header {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 2.5rem;
  }

  .process-overview__title {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .process-overview__subtitle {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .process-overview__steps {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process-overview__step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem 1.25rem;
    align-items: start;
    padding: 1.25rem 1.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
  }

  .process-overview__number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-on-primary);
    background: var(--color-primary);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .process-overview__content h3 {
    margin: 0 0 0.375rem;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-secondary);
  }

  .process-overview__content p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-muted);
  }

  .process-overview__cta {
    margin-top: 2.5rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .process-overview__steps {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .process-overview__steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
