---
import type { Articulo } from '../../utils/articles';
import { formatArticleDate, getArticleHref } from '../../utils/articles';

interface Props {
  article: Articulo;
}

const { article } = Astro.props;
const { title, description, pubDate, category, image } = article.data;
const href = getArticleHref(article.id);
const cover = image ?? 'https://images.unsplash.com/photo-1503387762-592deb58ef4e?w=800&q=80';
---

<a href={href} class="article-card">
  <div class="article-card__media">
    <img src={cover} alt="" loading="lazy" decoding="async" />
  </div>
  <div class="article-card__body">
    <span class="article-card__category">{category}</span>
    <h2 class="article-card__title">{title}</h2>
    <p class="article-card__excerpt">{description}</p>
    <time class="article-card__date" datetime={pubDate.toISOString()}>
      {formatArticleDate(pubDate)}
    </time>
  </div>
</a>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
    transition: box-shadow var(--transition-fast), transform var(--transition-fast);
  }

  .article-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(13, 20, 26, 0.08);
  }

  .article-card__media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-border);
  }

  .article-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem;
    gap: 0.375rem;
  }

  .article-card__category {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
  }

  .article-card__title {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-secondary);
  }

  .article-card__excerpt {
    margin: 0;
    flex: 1;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-card__date {
    font-size: 0.75rem;
    color: var(--color-muted);
  }
</style>
