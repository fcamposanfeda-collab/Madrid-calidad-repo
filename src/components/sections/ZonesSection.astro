---
const zones = [
  'Madrid capital',
  'Chamberí',
  'Arganzuela',
  'Alcorcón',
  'Móstoles',
  'Getafe',
  'Leganés',
  'Fuenlabrada',
  'Pozuelo de Alarcón',
  'Las Rozas',
  'Alcobendas',
  'Torrejón de Ardoz',
  'Rivas-Vaciamadrid',
  'Tres Cantos',
  'Boadilla del Monte',
  'Majadahonda',
];
---

<section class="zones section" aria-labelledby="zones-title">
  <div class="container zones__inner">
    <h2 id="zones-title" class="zones__title">Trabajamos en toda la Comunidad de Madrid</h2>
    <p class="zones__intro">
      Rehabilitación, reformas integrales y eficiencia energética en la capital y principales municipios.
      Si tienes dudas sobre tu zona, contáctanos.
    </p>
    <ul class="zones__list">
      {zones.map((zone) => <li>{zone}</li>)}
    </ul>
  </div>
</section>

<style>
  .zones__inner {
    text-align: center;
    max-width: 48rem;
    margin-inline: auto;
  }

  .zones__title {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading);
    font-size: clamp(1.375rem, 3vw, 1.875rem);
    font-weight: 700;
    text-transform: uppercase;
  }

  .zones__intro {
    margin: 0 0 1.5rem;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .zones__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .zones__list li {
    padding: 0.375rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 500;
    background: #f8fafc;
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }
</style>
