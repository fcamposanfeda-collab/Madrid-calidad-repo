---
import { trustStats } from '../../data/trust-stats';
---

<section class="trust-bar" aria-label="Cifras de confianza">
  <div class="container trust-bar__grid">
    {
      trustStats.map((stat) => (
        <div class="trust-bar__item">
          <p class="trust-bar__value">{stat.value}</p>
          <p class="trust-bar__label">{stat.label}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .trust-bar {
    background: var(--color-primary);
    color: var(--color-on-primary);
    padding-block: 1.75rem;
  }

  .trust-bar__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 1rem;
    text-align: center;
  }

  .trust-bar__value {
    margin: 0 0 0.25rem;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .trust-bar__label {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 500;
    opacity: 0.9;
    line-height: 1.35;
  }

  @media (min-width: 768px) {
    .trust-bar__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }

    .trust-bar__label {
      font-size: 0.875rem;
    }
  }
</style>
