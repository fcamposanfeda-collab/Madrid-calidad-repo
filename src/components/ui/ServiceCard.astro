---
interface Props {
  title: string;
  image: string;
  imageAlt: string;
  href?: string;
  eager?: boolean;
}

const { title, image, imageAlt, href, eager = false } = Astro.props;
---

{href ? (
  <a href={href} class="service-card service-card--link">
    <div class="service-card__media">
      <img src={image} alt={imageAlt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    </div>
    <h3 class="service-card__title">{title}</h3>
  </a>
) : (
  <article class="service-card">
    <div class="service-card__media">
      <img src={image} alt={imageAlt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    </div>
    <h3 class="service-card__title">{title}</h3>
  </article>
)}

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: var(--color-bg);
    border-radius: 0.5rem;
    overflow: hidden;
    transition: transform var(--transition-fast);
  }

  .service-card--link:hover,
  .service-card--link:focus-visible {
    transform: translateY(-4px);
  }

  .service-card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-border);
  }

  .service-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service-card__title {
    margin: 0 0 0.5rem;
    padding-inline: 0.25rem;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
</style>
