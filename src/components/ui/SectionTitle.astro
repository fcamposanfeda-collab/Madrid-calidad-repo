---
interface Props {
  title: string;
  subtitle?: string;
  as?: 'h1' | 'h2' | 'h3';
  align?: 'left' | 'center';
  id?: string;
}

const { title, subtitle, as: Tag = 'h2', align = 'left', id } = Astro.props;
---

<div class:list={['section-title', `section-title--${align}`]}>
  <Tag class="section-title__heading" id={id}>{title}</Tag>
  {subtitle && <p class="section-title__subtitle">{subtitle}</p>}
</div>

<style>
  .section-title {
    margin-bottom: 2rem;
  }

  .section-title--center {
    text-align: center;
  }

  .section-title__heading {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.15;
  }

  .section-title__subtitle {
    margin: 0;
    font-size: 1.0625rem;
    color: var(--color-muted);
    max-width: 42rem;
  }

  .section-title--center .section-title__subtitle {
    margin-inline: auto;
  }
</style>
