---
import { contact, whatsappHref } from '../../data/contact';
---

<div class="sticky-cta" aria-label="Acciones rápidas">
  <a class="sticky-cta__btn sticky-cta__btn--call" href={`tel:${contact.phone.replace(/\s/g, '')}`}>
    Llamar
  </a>
  <a
    class="sticky-cta__btn sticky-cta__btn--whatsapp"
    href={whatsappHref('Hola, os escribo desde la web. Quiero presupuesto para una obra.')}
    target="_blank"
    rel="noopener noreferrer"
  >
    WhatsApp
  </a>
  <a class="sticky-cta__btn sticky-cta__btn--contact" href="/presupuestos">Presupuesto</a>
</div>

<a
  class="wa-float"
  href={whatsappHref('Hola, os escribo desde la web. Quiero información sobre una obra.')}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escríbenos por WhatsApp"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.48-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.27.49 1.7.63.71.23 1.36.2 1.88.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.4 9.4 0 0 1-4.8-1.31l-.34-.2-3.57.93.95-3.48-.22-.36a9.4 9.4 0 0 1-1.44-5.01c0-5.2 4.24-9.44 9.45-9.44a9.4 9.4 0 0 1 9.44 9.45c0 5.2-4.24 9.43-9.45 9.43m8.04-17.48A11.3 11.3 0 0 0 12.05.7C5.78.7.68 5.8.68 12.06c0 2 .52 3.96 1.52 5.68L.58 23.7l6.1-1.6a11.3 11.3 0 0 0 5.37 1.37h.01c6.27 0 11.37-5.1 11.37-11.37 0-3.04-1.18-5.9-3.33-8.04"/>
  </svg>
</a>

<style>
  .sticky-cta {
    display: flex;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 150;
    box-shadow: 0 -2px 12px rgba(13, 20, 26, 0.1);
  }

  .sticky-cta__btn {
    flex: 1;
    padding: 0.875rem 0.5rem;
    text-align: center;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .sticky-cta__btn--call {
    background: var(--color-secondary);
    color: var(--color-on-primary);
  }

  .sticky-cta__btn--whatsapp {
    background: #1f8f4e;
    color: #ffffff;
  }

  .sticky-cta__btn--contact {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .wa-float {
    display: none;
  }

  @media (min-width: 1100px) {
    .sticky-cta {
      display: none;
    }

    .wa-float {
      display: flex;
      align-items: center;
      justify-content: center;
      position: fixed;
      right: 1.5rem;
      bottom: 1.5rem;
      z-index: 150;
      width: 3.5rem;
      height: 3.5rem;
      border-radius: 50%;
      background: #25d366;
      color: #ffffff;
      box-shadow: 0 4px 14px rgba(13, 20, 26, 0.25);
      transition: transform 0.2s ease;
    }

    .wa-float:hover,
    .wa-float:focus-visible {
      transform: scale(1.08);
    }
  }

  @media (max-width: 1099px) {
    :global(body) {
      padding-bottom: 3rem;
    }
  }
</style>
