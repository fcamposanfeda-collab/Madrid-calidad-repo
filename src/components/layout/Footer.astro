---
import { site } from '../../data/site';
import { legalNav } from '../../data/navigation';
import { contact } from '../../data/contact';
---

<footer class="footer" aria-label="Pie de página">
  <div class="footer__main container">
    <div class="footer__contact">
      <h2 class="footer__title">Contacto</h2>
      <p class="footer__subtitle">Estamos aquí para ayudarte siempre</p>
      <dl class="footer__details">
        <div class="footer__detail">
          <dt>Email</dt>
          <dd>
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </dd>
        </div>
        <div class="footer__detail">
          <dt>Teléfono</dt>
          <dd>
            <a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a>
          </dd>
        </div>
      </dl>
    </div>

    <div class="footer__aside">
      <p class="footer__tagline">{site.tagline}</p>
      <a
        href={contact.instagram}
        class="footer__social"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram de Madrid Calidad Constructiva"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
          ></path>
        </svg>
      </a>
    </div>
  </div>

  <div class="footer__bottom container">
    <p class="footer__copyright">{site.copyright}</p>
    <nav class="footer__legal" aria-label="Enlaces legales">
      <ul class="footer__legal-list">
        {
          legalNav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-footer-bg);
    color: var(--color-on-primary);
  }

  .footer__main {
    display: grid;
    gap: 2rem;
    padding-block: var(--section-padding-mobile);
  }

  .footer__title {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-on-primary);
  }

  .footer__subtitle {
    margin: 0 0 1.25rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .footer__details {
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  .footer__detail dt {
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .footer__detail dd {
    margin: 0;
  }

  .footer__detail a {
    color: var(--color-on-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer__detail a:hover {
    opacity: 0.85;
  }

  .footer__aside {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer__tagline {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .footer__social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--color-on-primary);
    transition: opacity var(--transition-fast);
  }

  .footer__social:hover {
    opacity: 0.8;
  }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .footer__copyright {
    margin: 0;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .footer__legal-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }

  .footer__legal-list a {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer__legal-list a:hover {
    color: var(--color-on-primary);
  }

  @media (min-width: 768px) {
    .footer__main {
      grid-template-columns: 1fr auto;
      align-items: start;
      padding-block: var(--section-padding-desktop);
    }

    .footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
