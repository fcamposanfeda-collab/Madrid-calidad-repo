---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageMeta } from '../data/pages-meta';

const meta = getPageMeta('/contacto');
---

<BaseLayout title={meta.title} description={meta.description}>
  <section class="page-placeholder container">
    <h1>Contáctanos</h1>
    <p>Ponte en contacto con nosotros. Estaremos encantados de ayudarte con tu proyecto de forma personalizada.</p>
    <p><em>Formulario y datos — Fase 3 (SPEC-303).</em></p>
  </section>
</BaseLayout>
