---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceLandingContent from '../../components/sections/ServiceLandingContent.astro';
import { allServiceLandings, getServiceBySlug } from '../../data/services-seo';
import { getPublishedArticles, getArticlesForService } from '../../utils/articles';

export function getStaticPaths() {
  return allServiceLandings.map((service) => ({
    params: { slug: service.slug },
  }));
}

const { slug } = Astro.params;
const service = getServiceBySlug(slug!);

if (!service) {
  return Astro.redirect('/servicios');
}

const allArticles = await getPublishedArticles();
const relatedArticles = getArticlesForService(slug!, allArticles);
---

<BaseLayout title={service.title} description={service.description}>
  <ServiceLandingContent service={service} relatedArticles={relatedArticles} />
</BaseLayout>
