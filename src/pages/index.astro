---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageMeta } from '../data/pages-meta';
import { images } from '../data/images';
import Hero from '../components/sections/Hero.astro';
import ServicePills from '../components/sections/ServicePills.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import ServicesGrid from '../components/sections/ServicesGrid.astro';
import RehabPlan from '../components/sections/RehabPlan.astro';
import ContactSection from '../components/sections/ContactSection.astro';

const meta = getPageMeta('/');
---

<BaseLayout title={meta.title} description={meta.description} preloadImage={images.hero.src}>
  <Hero />
  <ServicePills />
  <AboutSection />
  <ServicesGrid />
  <RehabPlan />
  <ContactSection />
</BaseLayout>
