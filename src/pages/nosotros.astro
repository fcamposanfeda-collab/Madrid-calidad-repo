---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { aboutContent } from '../data/home-content';
import { stockImages } from '../data/placeholders';

const title = 'Sobre nosotros | Madrid Calidad Constructiva';
const description =
  'Madrid Calidad Constructiva: rehabilitación energética, reformas integrales y gestión de subvenciones en Madrid.';
---

<BaseLayout title={title} description={description}>
  <header class="about-hero section">
    <div class="container about-hero__grid">
      <div>
        <h1>Sobre Madrid Calidad Constructiva</h1>
        <p>
          Somos especialistas en rehabilitación energética y reformas integrales en la Comunidad de Madrid.
          Ofrecemos un servicio completo: diagnóstico técnico, gestión de ayudas, proyecto, ejecución y
          certificación.
        </p>
        <Button href="/presupuestos" variant="primary">Solicitar presupuesto</Button>
      </div>
      <img src={stockImages.fachada.src} alt={stockImages.fachada.alt} width="640" height="400" loading="eager" />
    </div>
  </header>

  <section class="section content">
    <div class="container content__inner">
      <h2>{aboutContent.title}</h2>
      <p>{aboutContent.text}</p>
      <h2>Nuestro compromiso</h2>
      <ul>
        <li>Transparencia en presupuestos y plazos</li>
        <li>Coordinación técnica y administrativa integral</li>
        <li>Enfoque en eficiencia, confort y sostenibilidad</li>
        <li>Atención a comunidades de propietarios y particulares</li>
      </ul>
      <div class="content__actions">
        <Button href="/como-lo-hacemos" variant="outline">Cómo lo hacemos</Button>
        <Button href="/contacto" variant="primary">Contacto</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    background: #f8fafc;
    border-bottom: 1px solid var(--color-border);
  }

  .about-hero__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .about-hero h1 {
    margin: 0 0 1rem;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 2.75rem);
    text-transform: uppercase;
    line-height: 1.1;
  }

  .about-hero p {
    margin: 0 0 1.5rem;
    line-height: 1.75;
    color: var(--color-muted);
  }

  .about-hero img {
    border-radius: 0.5rem;
    width: 100%;
    object-fit: cover;
  }

  .content__inner {
    max-width: 48rem;
  }

  .content h2 {
    margin: 2rem 0 0.75rem;
    font-family: var(--font-heading);
    font-size: 1.375rem;
    text-transform: uppercase;
  }

  .content h2:first-child {
    margin-top: 0;
  }

  .content p,
  .content li {
    line-height: 1.75;
  }

  .content ul {
    padding-left: 1.25rem;
    list-style: disc;
  }

  .content__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  @media (min-width: 768px) {
    .about-hero__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
