---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPageMeta } from '../../data/pages-meta';
import { articlesPageContent } from '../../data/page-content';
import PageHeader from '../../components/sections/PageHeader.astro';
import ArticlesEmpty from '../../components/sections/ArticlesEmpty.astro';

const meta = getPageMeta('/articulos');
---

<BaseLayout title={meta.title} description={meta.description}>
  <PageHeader title={articlesPageContent.title} centered={true} />
  <ArticlesEmpty />
</BaseLayout>
