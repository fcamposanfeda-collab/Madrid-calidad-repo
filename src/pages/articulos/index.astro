---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Fragment } from 'astro/jsx-runtime';
import { getPageMeta } from '../../data/pages-meta';
import { site } from '../../data/site';
import PageHeader from '../../components/sections/PageHeader.astro';
import ArticleCard from '../../components/sections/ArticleCard.astro';
import ArticleCta from '../../components/sections/ArticleCta.astro';
import BlogIndexSchema from '../../components/seo/BlogIndexSchema.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import { getPublishedArticles } from '../../utils/articles';

const meta = getPageMeta('/articulos');
const articles = await getPublishedArticles();
const pageUrl = new URL('/articulos', site.url).href;

const categories = [...new Set(articles.map((a) => a.data.category))].sort();
---

<BaseLayout title={meta.title} description={meta.description}>
  <Fragment slot="head">
    <BlogIndexSchema articles={articles} pageUrl={pageUrl} />
    <BreadcrumbSchema
      items={[
        { name: 'Inicio', url: '/' },
        { name: 'Artículos' },
      ]}
    />
  </Fragment>
  <PageHeader
    title="Blog de rehabilitación y reformas en Madrid"
    subtitle="Guías prácticas sobre eficiencia energética, SATE, subvenciones, reformas integrales y mantenimiento de edificios. Escrito por nuestro equipo técnico."
    centered={true}
  />

  <section class="section blog-index" aria-label="Listado de artículos">
    <div class="container">
      <p class="blog-index__intro">
        En Madrid Calidad Constructiva publicamos artículos para ayudarte a tomar decisiones informadas
        sobre tu vivienda o comunidad de propietarios: desde cómo acceder a ayudas públicas hasta cuándo
        rehabilitar una fachada o impermeabilizar una cubierta. Si tienes dudas concretas,
        <a href="/presupuestos">solicita presupuesto sin compromiso</a>.
      </p>

      {
        categories.length > 1 && (
          <nav class="blog-index__categories" aria-label="Categorías del blog">
            <span class="blog-index__categories-label">Temas:</span>
            {categories.map((category) => (
              <span class="blog-index__category-tag">{category}</span>
            ))}
          </nav>
        )
      }

      {
        articles.length > 0 ? (
          <div class="blog-index__grid">
            {articles.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        ) : (
          <p class="blog-index__empty">Próximamente publicaremos nuevos artículos.</p>
        )
      }
    </div>
  </section>

  <ArticleCta />
</BaseLayout>

<style>
  .blog-index__intro {
    max-width: 48rem;
    margin: 0 auto 2rem;
    text-align: center;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-muted);
  }

  .blog-index__intro a {
    color: var(--color-primary);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .blog-index__categories {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .blog-index__categories-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-muted);
    margin-right: 0.25rem;
  }

  .blog-index__category-tag {
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-primary);
    background: rgba(41, 90, 130, 0.08);
    border-radius: 999px;
  }

  .blog-index__grid {
    display: grid;
    gap: 1.5rem;
  }

  .blog-index__empty {
    text-align: center;
    color: var(--color-muted);
    padding-block: 3rem;
  }

  @media (min-width: 768px) {
    .blog-index__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .blog-index__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
