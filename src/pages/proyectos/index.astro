---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
import BeforeAfter from '../../components/ui/BeforeAfter.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import { projects, getProjectHref } from '../../data/projects';

const title = 'Proyectos de rehabilitación y reformas en Madrid | Madrid Calidad Constructiva';
const description =
  'Portfolio de obras de rehabilitación energética, SATE, fachadas y reformas integrales en Madrid y Comunidad de Madrid.';
---

<BaseLayout title={title} description={description}>
  <header class="page-hero section">
    <div class="container page-hero__inner">
      <h1>Proyectos realizados</h1>
      <p>
        Muestra de trabajos en rehabilitación energética, SATE, fachadas, cubiertas y reformas integrales.
        Próximamente añadiremos más fichas con fotos de obra.
      </p>
      <Button href="/presupuestos" variant="primary">Solicitar presupuesto</Button>
    </div>
  </header>

  <section class="section compare">
    <div class="container compare__inner">
      <SectionTitle
        title="Antes y después"
        subtitle="Arrastra la barra para comparar el estado inicial y la reforma terminada."
      />
      <BeforeAfter
        beforeSrc="/img/antes.jpg"
        afterSrc="/img/despues.jpg"
        beforeAlt="Patio antes de la reforma, con el suelo sin terminar"
        afterAlt="Patio reformado, con pavimento de piedra y jardineras"
        aspectRatio="4 / 3"
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="projects-grid">
        {
          projects.map((project) => (
            <a href={getProjectHref(project.slug)} class="project-card">
              <img src={project.image.src} alt={project.image.alt} loading="lazy" decoding="async" />
              <div class="project-card__body">
                <span>{project.service}</span>
                <h2>{project.title}</h2>
                <p>{project.excerpt}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: #f8fafc;
    border-bottom: 1px solid var(--color-border);
  }

  .page-hero__inner {
    max-width: 42rem;
  }

  .page-hero h1 {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 2.75rem);
    text-transform: uppercase;
  }

  .page-hero p {
    margin: 0 0 1.5rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .compare {
    padding-bottom: 0;
  }

  .compare__inner {
    max-width: 52rem;
  }

  .projects-grid {
    display: grid;
    gap: 1.5rem;
  }

  .project-card {
    display: block;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--color-bg);
    transition: box-shadow var(--transition-fast);
  }

  .project-card:hover {
    box-shadow: 0 12px 32px rgba(13, 20, 26, 0.08);
  }

  .project-card img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .project-card__body {
    padding: 1.25rem;
  }

  .project-card__body span {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
  }

  .project-card__body h2 {
    margin: 0.375rem 0;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .project-card__body p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
