---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageMeta } from '../data/pages-meta';
import { processIntro } from '../data/process-steps';
import PageHeader from '../components/sections/PageHeader.astro';
import ProcessTimeline from '../components/sections/ProcessTimeline.astro';

const meta = getPageMeta('/como-lo-hacemos');
---

<BaseLayout title={meta.title} description={meta.description}>
  <PageHeader title={processIntro.title} subtitle={processIntro.subtitle} />
  <ProcessTimeline />
</BaseLayout>
