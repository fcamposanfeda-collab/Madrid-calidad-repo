# Copia este archivo como .env (desarrollo) o .env.production (build local)

# Web3Forms: el destino es el correo con el que se creó la Access Key.
PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
# Presupuestos
PUBLIC_WEB3FORMS_ACCESS_KEY=
# Contacto
PUBLIC_WEB3FORMS_CONTACT_ACCESS_KEY=

# FormSubmit exige confirmar un enlace en el buzón antes del primer envío:
# PUBLIC_FORM_ENDPOINT=https://formsubmit.co/ajax/dcampos@madridcalidad.es

# Formspree (alternativa). No hace falta access key:
# PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx

# ─── Google Analytics (opcional, solo tras aceptar cookies) ──────────────────
# PUBLIC_GA_ID=
