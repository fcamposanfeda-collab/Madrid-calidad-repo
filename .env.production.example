# Plantilla para producción — copia como .env.production antes de npm run build
PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
# UUID de https://web3forms.com. Déjalos vacíos hasta pegar la clave real.
# Presupuestos
PUBLIC_WEB3FORMS_ACCESS_KEY=
# Contacto
PUBLIC_WEB3FORMS_CONTACT_ACCESS_KEY=

# FormSubmit exige activar el buzón con un enlace antes de entregar correos:
# PUBLIC_FORM_ENDPOINT=https://formsubmit.co/ajax/dcampos@madridcalidad.es
